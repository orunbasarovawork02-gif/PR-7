<%- include("partials/head", { title: title }) %>
<body>
    <%- include("partials/header") %>

    <main class="container form-container">
        <h1>Добавить достопримечательность</h1>

        <% if (error) { %>
            <p class="errors"><%= error %></p>
        <% } %>

        <form class="place-form" action="/add" method="POST">
            <label for="name">Название</label>
            <input id="name" name="name" required>

            <label for="description">Описание</label>
            <textarea id="description" name="description" required></textarea>

            <label for="address">Адрес</label>
            <input id="address" name="address" required>

            <label for="time">Время посещения</label>
            <input id="time" name="time" placeholder="1-2 часа">

            <label for="image">Имя файла изображения</label>
            <input id="image" name="image" placeholder="bayterek.jpg">

            <button class="button" type="submit">Добавить</button>
        </form>

        <a href="/" class="back-link">Вернуться на главную</a>
    </main>
</body>
</html>
